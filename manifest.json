{
  "manifest_version": 3,
  "name": "CarrierSource Free Data Collector",
  "version": "1.0.3",
  "description": "Collect freely visible carrier data from CarrierSource pages via DOM extraction. Requires written authorization for automated collection.",
  "permissions": [
    "storage",
    "sidePanel",
    "downloads",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://www.carriersource.io/*",
    "https://carriersource.io/*"
  ],
  "background": {
    "service_worker": "background/serviceWorker.js",
    "type": "module"
  },
  "action": {
    "default_title": "CarrierSource Free Data Collector",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.carriersource.io/*",
        "https://carriersource.io/*"
      ],
      "js": ["content/contentScript.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

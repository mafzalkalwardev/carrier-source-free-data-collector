{
  "name": "CarrierSource Free Data Collector",
  "short_name": "Free Data Collector",
  "description": "Local Chrome extension that collects freely visible CarrierSource carrier cards and exports CSV or Excel.",
  "start_url": "/",
  "scope": "/",
  "display": "browser",
  "background_color": "#efece4",
  "theme_color": "#141c2b",
  "lang": "en",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
